# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# OS-specific files
.DS_Store          # macOS
Thumbs.db          # Windows
Desktop.ini        # Windows

# User-specific settings
UserSettings/

# Visual Studio and Rider cache directories
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.csharpierrc.json

# Autogenerated files
ExportedObj/
.consulo/
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Unity crash reports and metadata files
sysinfo.txt

# Ignore Asset Store tools, if used
Assets/AssetStoreTools*

# Exclude builds and executables
*.apk
*.unitypackage

# Include meta files (important for Unity asset references)
!/[Aa]ssets/**/*.meta

# Optional: Uncomment to ignore specific plugins or tools if desired
# /Assets/Plugins/Editor/JetBrains*